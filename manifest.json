{
    "manifest_version": 3,
    "name": "PrivacyRedirect+",
    "version": "1.1.0",
    "description": "Automatically redirects visits from known platforms to open-source, privacy-friendly alternatives.",
    "permissions": ["webNavigation", "storage"],
    "background": {
      "service_worker": "service_worker.js",
      "type": "module"
    },
    "options_page": "options.html",
    "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png"
    },
    "action": {
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png",
            "48": "icons/icon48.png",
            "64": "icons/icon64.png",
            "128": "icons/icon128.png"
        },
        "default_title": "PrivacyRedirect+",
        "default_popup": "popup.html"
    }
}
